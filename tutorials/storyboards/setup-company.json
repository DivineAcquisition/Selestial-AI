{
  "tutorial": "setup-company",
  "version": 2,
  "title": "Set up your company",
  "voice": {
    "provider": "elevenlabs",
    "voiceId": "cjVigY5qzO86Huf0OWal",
    "name": "Eric",
    "model": "eleven_multilingual_v2",
    "settings": {
      "stability": 0.55,
      "similarity_boost": 0.75,
      "style": 0.1,
      "use_speaker_boost": true
    },
    "say": {
      "Selestial": "Celestial"
    }
  },
  "mark": false,
  "sampleData": "Fictional company Juniper Cleaning Co., Austin TX. A fresh demo owner from tutorials/demo/owner.mjs (no company yet). Nothing real is shown.",
  "scenes": [
    {
      "id": "title",
      "narration": "Let's set up your company. You choose what to start with, confirm a few essentials, and Selestial builds your workspace around it.",
      "capture": {
        "kind": "card",
        "eyebrow": "Setup guide · 1 of 6",
        "title": "Set up your company",
        "body": "Choose your first outcome, confirm a few essentials, and build your workspace.",
        "left": "Juniper Cleaning Co. is a fictional demo company.",
        "seconds": 8
      },
      "minSeconds": 5
    },
    {
      "id": "create",
      "narration": "Name your company and confirm your time zone. Schedules, availability and deadlines all run on this clock.",
      "capture": {
        "kind": "playwright",
        "start": "/app",
        "actions": [
          {
            "do": "type",
            "target": {
              "role": "textbox",
              "name": "Company name"
            },
            "text": "Juniper Cleaning Co."
          },
          {
            "do": "click",
            "target": {
              "role": "combobox",
              "name": "Time zone"
            }
          },
          {
            "do": "type",
            "target": {
              "role": "combobox",
              "name": "Time zone"
            },
            "text": "Chicago",
            "clear": true
          },
          {
            "do": "click",
            "target": {
              "role": "option",
              "name": "Central Time (Chicago, Dallas, Houston)"
            }
          },
          {
            "do": "click",
            "target": {
              "role": "checkbox",
              "name": "I accept the Terms of Service"
            }
          },
          {
            "do": "click",
            "target": {
              "role": "button",
              "name": "Create company"
            }
          },
          {
            "do": "waitFor",
            "target": {
              "role": "heading",
              "name": "What would you like Selestial to help you accomplish first?"
            },
            "cut": true,
            "timeout": 45000
          },
          {
            "do": "pause",
            "ms": 1200
          }
        ]
      },
      "minSeconds": 6
    },
    {
      "id": "outcome",
      "narration": "Choose what you'd like help with first. Here, launching a booking form. You can add other priorities after your first result.",
      "capture": {
        "kind": "playwright",
        "actions": [
          {
            "do": "hover",
            "target": "text=Turn more inquiries into bookings"
          },
          {
            "do": "click",
            "target": "text=Launch my booking form"
          },
          {
            "do": "pause",
            "ms": 900
          },
          {
            "do": "click",
            "target": {
              "role": "button",
              "name": "Continue"
            }
          },
          {
            "do": "waitFor",
            "target": {
              "role": "heading",
              "name": "Confirm a few essentials"
            },
            "cut": true
          }
        ]
      },
      "minSeconds": 6
    },
    {
      "id": "essentials",
      "narration": "Confirm a few essentials: where you're based and the kinds of cleaning you do. If you have a website, Selestial can suggest these, and nothing is used until you choose it.",
      "capture": {
        "kind": "playwright",
        "actions": [
          {
            "do": "highlight",
            "target": "text=Have a website? Let Selestial help fill this in.",
            "note": "Optional"
          },
          {
            "do": "type",
            "target": {
              "role": "textbox",
              "name": "Where you're based"
            },
            "text": "Austin, TX"
          },
          {
            "do": "click",
            "target": "text=Homes >> nth=0"
          },
          {
            "do": "highlight",
            "target": "aside[aria-label='What Selestial knows so far']"
          },
          {
            "do": "click",
            "target": {
              "role": "button",
              "name": "Continue"
            }
          },
          {
            "do": "waitFor",
            "target": {
              "role": "heading",
              "name": "Add what makes your first result useful"
            },
            "cut": true
          }
        ]
      },
      "minSeconds": 8
    },
    {
      "id": "context",
      "narration": "Selestial only asks what changes your first result. Prices can wait: customers can ask for a quote until you set them.",
      "capture": {
        "kind": "playwright",
        "actions": [
          {
            "do": "click",
            "target": "text=I'll finish pricing later"
          },
          {
            "do": "pause",
            "ms": 1000
          },
          {
            "do": "click",
            "target": {
              "role": "button",
              "name": "Continue"
            }
          },
          {
            "do": "waitFor",
            "target": {
              "role": "heading",
              "name": "Build my workspace"
            },
            "cut": true
          }
        ]
      },
      "minSeconds": 6
    },
    {
      "id": "build",
      "narration": "Then build your workspace. Selestial prepares drafts in the background. Nothing is published, sent or charged without you.",
      "capture": {
        "kind": "playwright",
        "actions": [
          {
            "do": "highlight",
            "target": "#control-heading",
            "note": "You stay in control"
          },
          {
            "do": "pause",
            "ms": 1200
          },
          {
            "do": "click",
            "target": {
              "role": "button",
              "name": "Build my workspace"
            }
          },
          {
            "do": "waitFor",
            "target": "#lead-result",
            "cut": true,
            "timeout": 90000
          },
          {
            "do": "pause",
            "ms": 800
          }
        ]
      },
      "minSeconds": 6
    },
    {
      "id": "result",
      "narration": "Your first result leads: here, a booking form draft, with exactly what it still needs before it can go live. Review it now, or finish later.",
      "capture": {
        "kind": "playwright",
        "actions": [
          {
            "do": "highlight",
            "target": "article:has(#lead-result)"
          },
          {
            "do": "pause",
            "ms": 1800
          },
          {
            "do": "highlight",
            "target": {
              "role": "button",
              "name": "Preview and review"
            }
          },
          {
            "do": "pause",
            "ms": 1200
          }
        ]
      },
      "minSeconds": 7
    },
    {
      "id": "next",
      "narration": "That's your company set up. Next, build your services and pricing, so customers and your agents work from real prices.",
      "capture": {
        "kind": "card",
        "eyebrow": "Up next",
        "title": "Build your services and pricing",
        "whereLabel": "In the sidebar:",
        "where": "Services & Pricing",
        "left": "Setup guide · 1 of 6",
        "seconds": 8
      },
      "minSeconds": 6
    }
  ]
}
